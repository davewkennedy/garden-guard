{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug selected CMake target",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "CMake: build",
      "setupCommands": [
        { "description": "Pretty-print STL and Qt types", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
